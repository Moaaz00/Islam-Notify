<?xml version="1.0" encoding="utf-8"?>
<!-- Expanded prayer notification (inside DecoratedCustomViewStyle). Only RemoteViews-supported
     views; text uses the device's own notification styles. The Hijri date • city is in the system
     header (subtext). Spacing: 2.8dp · hero · following event · 4dp · bar (16dp view, 4dp bar)
     · 4dp · table (rows 6dp apart). The hero and the following-event line read as one unit; the
     bar sits closer to them than to the table. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ExpandedRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- ④ Hero: same words as the collapsed line 2, at 18.7sp (14sp × 4/3): the focal point, a
         clear step above the 14sp table without overpowering it. -->
    <LinearLayout
        android:id="@+id/HeroInline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2.8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/HeroName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAlignment="viewStart"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
            android:textSize="18.7sp"
            android:textStyle="bold" />

        <Chronometer
            android:id="@+id/HeroCountdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
            android:textSize="18.7sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ⑤ The event after the hero: "Then Iqama al-Asr" + "at 3:50 PM". Secondary to the hero
         (11sp regular, faded with android:alpha so it follows light/dark mode) and a clock time,
         so only the hero's countdown moves. Only the name can be cut, never the time. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:alpha="0.7"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/FollowingName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAlignment="viewStart"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
            android:textSize="11sp"
            android:textStyle="normal" />

        <TextView
            android:id="@+id/FollowingTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
            android:textSize="11sp"
            android:textStyle="normal" />
    </LinearLayout>

    <!-- ⑥ Previous event → hero. The platform's own notification progress style. Its drawable is
         a 4dp bar centred in the view (gravity center_vertical), and the style makes the view 16dp
         tall (minHeight/maxHeight), so 6dp of empty view lies above and below the bar and adds to
         the margins. -->
    <ProgressBar
        android:id="@+id/Progress"
        style="@android:style/Widget.Material.Light.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:max="1000"
        android:progressBackgroundTint="@color/notification_progress_track"
        android:progressTint="@color/light_green" />

    <!-- ⑦ Table, 2 × 3. Fajr, Sunrise, Dhuhr | Asr, Maghrib, Isha. Each cell has a "Past" twin
         faded with android:alpha, shown instead of it once the prayer has passed. The fading is
         in the layout, not a colour set from code, so it follows light/dark mode when Android
         redraws the notification (RemoteViews can only call setAlpha from Android 12). -->
    <LinearLayout
        android:id="@+id/TableTwoColumns"
        android:layout_width="match_parent"
        android:baselineAligned="false"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/T2Name0"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAlignment="viewStart"
                    android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
                    android:textStyle="normal" />

                <TextView
                    android:id="@+id/T2Name0Past"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:alpha="0.5"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAlignment="viewStart"
                    android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
                    android:textStyle="normal"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/T2Time0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
                    android:textStyle="normal" />

                <TextView
                    android:id="@+id/T2Time0Past"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.5"
                    android:layout_marginStart="8dp"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
                    android:textStyle="normal"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/T2Name1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAlignment="viewStart"
                    android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
                    android:textStyle="normal" />

                <TextView
                    android:id="@+id/T2Name1Past"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:alpha="0.5"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAlignment="viewStart"
                    android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
                    android:textStyle="normal"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/T2Time1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
                    android:textStyle="normal" />

                <TextView
                    android:id="@+id/T2Time1Past"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.5"
                    android:layout_marginStart="8dp"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
                    android:textStyle="normal"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/T2Name2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAlignment="viewStart"
                    android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
                    android:textStyle="normal" />

                <TextView
                    android:id="@+id/T2Name2Past"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:alpha="0.5"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAlignment="viewStart"
                    android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
                    android:textStyle="normal"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/T2Time2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
                    android:textStyle="normal" />

                <TextView
                    android:id="@+id/T2Time2Past"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.5"
                    android:layout_marginStart="8dp"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
                    android:textStyle="normal"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="24dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/T2Name3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAlignment="viewStart"
                    android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
                    android:textStyle="normal" />

                <TextView
                    android:id="@+id/T2Name3Past"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:alpha="0.5"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAlignment="viewStart"
                    android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
                    android:textStyle="normal"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/T2Time3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
                    android:textStyle="normal" />

                <TextView
                    android:id="@+id/T2Time3Past"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.5"
                    android:layout_marginStart="8dp"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
                    android:textStyle="normal"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/T2Name4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAlignment="viewStart"
                    android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
                    android:textStyle="normal" />

                <TextView
                    android:id="@+id/T2Name4Past"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:alpha="0.5"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAlignment="viewStart"
                    android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
                    android:textStyle="normal"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/T2Time4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
                    android:textStyle="normal" />

                <TextView
                    android:id="@+id/T2Time4Past"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.5"
                    android:layout_marginStart="8dp"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
                    android:textStyle="normal"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/T2Name5"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAlignment="viewStart"
                    android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
                    android:textStyle="normal" />

                <TextView
                    android:id="@+id/T2Name5Past"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:alpha="0.5"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAlignment="viewStart"
                    android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
                    android:textStyle="normal"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/T2Time5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
                    android:textStyle="normal" />

                <TextView
                    android:id="@+id/T2Time5Past"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.5"
                    android:layout_marginStart="8dp"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
                    android:textStyle="normal"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
